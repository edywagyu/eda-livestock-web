#!/bin/bash
# pre-commit hook — Tom の事故再発防止 (2026-05-25 設置)
# このファイルが .git/hooks/pre-commit にコピーされた状態で動きます

set -e

RED='\033[0;31m'
YELLOW='\033[0;33m'
GREEN='\033[0;32m'
NC='\033[0m'

ERRORS=0

# === Check 1: build.py が再有効化されていないか ===
if git diff --cached --name-only | grep -q "^scripts/build\.py$"; then
  echo -e "${RED}🚨 ABORT: scripts/build.py が再追加されようとしています${NC}"
  echo -e "${RED}   このファイルは Tom の編集を全消去した事故の元凶です。${NC}"
  echo -e "${RED}   絶対に有効化しないでください。${NC}"
  echo -e "${YELLOW}   どうしても必要な場合は Tom に直接確認後、--no-verify で commit してください。${NC}"
  ERRORS=$((ERRORS + 1))
fi

# === Check 2: 大規模削除がないか ===
# ROOT HTML ファイルが 500行以上削除されていれば警告
for file in $(git diff --cached --name-only --diff-filter=M | grep -E "^[^/]+\.html$"); do
  deleted=$(git diff --cached --numstat "$file" | awk '{print $2}')
  if [ -n "$deleted" ] && [ "$deleted" -gt 500 ]; then
    echo -e "${YELLOW}⚠️  WARNING: $file から $deleted 行削除されようとしています${NC}"
    echo -e "${YELLOW}   過去に '全ページ再ビルド' commit が大量損失を起こしました。${NC}"
    echo -e "${YELLOW}   本当にこの削除が意図通りか確認してください。${NC}"
    echo ""
    echo -e "${YELLOW}   続行する場合: --no-verify を付けて commit${NC}"
    echo -e "${YELLOW}   キャンセルする場合: git reset HEAD ${file}${NC}"
    ERRORS=$((ERRORS + 1))
  fi
done

# === Check 3: 「四代目」表記の混入を検知 ===
# Tom が a5adff4 (05-23) で削除したので、再追加しようとしたら警告
new_yondaime=$(git diff --cached -U0 -- '*.html' | grep -E "^\+" | grep -c "四代目" 2>/dev/null || echo 0)
if [ "$new_yondaime" -gt 0 ]; then
  echo -e "${YELLOW}⚠️  WARNING: 「四代目」表記が $new_yondaime 箇所追加されています${NC}"
  echo -e "${YELLOW}   Tom 指示で削除済みのはずです (commit a5adff4)。意図的ですか？${NC}"
  ERRORS=$((ERRORS + 1))
fi

# === 結果 ===
if [ $ERRORS -gt 0 ]; then
  echo ""
  echo -e "${RED}=========================================${NC}"
  echo -e "${RED}commit は中断されました。$ERRORS 件の問題があります。${NC}"
  echo -e "${RED}本当に commit したい場合: git commit --no-verify${NC}"
  echo -e "${RED}=========================================${NC}"
  exit 1
fi

exit 0
