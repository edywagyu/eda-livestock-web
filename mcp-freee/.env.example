# freee アプリストアで発行した OAuth クライアント情報
FREEE_CLIENT_ID=
FREEE_CLIENT_SECRET=

# 認可コード取得後に使うリダイレクト URI。
# freee アプリ設定で「アプリ自体に登録」したものと完全一致させること。
# CLI ベースで動かす場合は urn:ietf:wg:oauth:2.0:oob が便利。
FREEE_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob

# 任意。既定の事業所 ID（指定すると毎回 company_id を渡さなくて済む）
# FREEE_COMPANY_ID=

# トークン保存先（既定は mcp-freee/.freee-tokens.json）
# FREEE_TOKEN_FILE=
