+/* ============================================================
+   🍚 エダチク米（常温便）の送料 — 2026-10-26 田崎さん決定
+   ------------------------------------------------------------
+   ・お米は常温便。送料は全国一律 ¥1,100(税込)
+   ・「¥11,000以上で送料無料」の対象外。20kg(¥14,256)1点でも ¥1,100 かかる
+   ・お肉(冷凍便)と同時購入なら送料は2件分（冷凍便の既存ロジック + お米 ¥1,100）
+   ・お米の金額は冷凍便側の送料無料判定の小計に含めない
+   ・freeShip 商品（はじめてセット等）・リピート送料半額・北海道沖縄の加算、
+     いずれもお米には効かせない
+   🔴 同じ規則が checkout.html の renderSummary にもある（表示と請求の二重実装）。
+      片方だけ直すと画面の金額と請求がズレるので、必ず両方そろえること。
+   ・照合キーは products の name と カートの title（在庫判定・BOM と同じ完全一致）
+   ・products シートが読めないときは、名前表(RICE_TITLES_)だけで判定する
+     ＝ fail-safe は「送料を頂く」側に倒す
+   ============================================================ */
+const RICE_SHIP_FEE = 1100;
+const RICE_TITLES_ = {
+  'エダチク米 精米 5kg': true, 'エダチク米 精米 10kg': true,
+  'エダチク米 精米 15kg': true, 'エダチク米 精米 20kg': true,
+  'エダチク米 玄米 5kg': true, 'エダチク米 玄米 10kg': true,
+  'エダチク米 玄米 15kg': true, 'エダチク米 玄米 20kg': true
+};
+
+/* products シートの category='rice' / temp='常温' を名前表に足して返す。
+   シートに米が増えてもこのファイルを直さずに送料がかかる。読めなければ名前表のみ。 */
+function riceTitleMap_() {
+  var map = {};
+  Object.keys(RICE_TITLES_).forEach(function (k) { map[k] = true; });
+  try {
+    const sh = ss().getSheetByName('products');
+    if (!sh) return map;
+    const data = sh.getDataRange().getValues();
+    if (data.length < 2) return map;
+    const headers = data[0];
+    const nameIdx = headers.indexOf('name');
+    const catIdx = headers.indexOf('category');
+    const tmpIdx = headers.indexOf('temp');
+    if (nameIdx === -1) return map;
+    for (var r = 1; r < data.length; r++) {
+      var isRice = (catIdx !== -1 && String(data[r][catIdx]).trim() === 'rice') ||
+                   (tmpIdx !== -1 && String(data[r][tmpIdx]).trim() === '常温');
+      if (isRice) map[String(data[r][nameIdx]).trim()] = true;
+    }
+  } catch (e) {
+    log('rice_title_map_warn', { error: e.message });
+  }
+  return map;
+}
+
+/* カートにお米が1点でもあれば ¥1,100、無ければ 0 */
+function riceShipping_(items) {
+  try {
+    const map = riceTitleMap_();
+    const has = (items || []).some(function (it) { return !!map[String((it && it.title) || '').trim()]; });
+    return has ? RICE_SHIP_FEE : 0;
+  } catch (e) {
+    log('rice_shipping_warn', { error: e.message });
+    return 0;
+  }
+}
+
+/* お米を除いた小計。冷凍便の「¥11,000以上 送料無料」判定はこれで行う。 */
+function subtotalExcludingRice_(items, keyFilter) {
+  const map = riceTitleMap_();
+  return (items || []).reduce(function (s, it) {
+    if (!it) return s;
+    if (map[String(it.title || '').trim()]) return s;
+    if (keyFilter && !keyFilter(it)) return s;
+    return s + it.price * it.qty;
+  }, 0);
+}
